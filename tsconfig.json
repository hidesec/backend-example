{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "baseUrl": "./src",
        "paths": {
            "@auth/*": ["auth/*"],
            "@config/*": ["config/*"],
            "@controllers/*": ["controllers/*"],
            "@database/*": ["database/*"],
            "@decorators/*": ["decorators/*"],
            "@di/*": ["di/*"],
            "@dto/*": ["dto/*"],
            "@entities/*": ["entities/*"],
            "@events/*": ["events/*"],
            "@http/*": ["http/*"],
            "@exceptions/*": ["exceptions/*"],
            "@lang/*": ["lang/*"],
            "@middlewares/*": ["middlewares/*"],
            "@repositories/*": ["repositories/*"],
            "@schedule/*": ["schedule/*"],
            "@services/*": ["services/*"],
            "@validation/*": ["validation/*"]
        }
    }
}